# SIMRSCB Backend — Konfigurasi Environment
# Salin file ini menjadi `.env` (tidak di-commit) dan isi nilai sesuai server lokal.

# ── MariaDB / MySQL ──────────────────────────────────────────────────────────
# Format: mysql://USER:PASS@HOST:PORT/DATABASE
# Khanza desktop dan web SIMRSCB berbagi database yang sama (TIDAK ALTER tabel Khanza).
DATABASE_URL=mysql://username:password@127.0.0.1:3306/sikcb10102023

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Ganti dengan string acak minimal 32 karakter. Contoh generate:
#   openssl rand -base64 48
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:3001

# ── BPJS Aplicare bed sync (opsional) ────────────────────────────────────────
# Kalau URL + CONS_ID + SECRET_KEY tidak terisi, cron Aplicare tidak dispawn
# (fitur menu tetap muncul di /aplicare/monitor, tapi sync akan error).
APLICARE_URL=https://new-api.bpjs-kesehatan.go.id/aplicaresws
APLICARE_CONS_ID=
APLICARE_SECRET_KEY=
# Kosongkan untuk auto-fallback ke setting.kode_ppk Khanza.
APLICARE_KODE_PPK=
# Interval cron dalam menit (default 10).
APLICARE_INTERVAL_MIN=10
